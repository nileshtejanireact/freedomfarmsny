    { "type": "textarea", "id": "variant_notes", "label": "Size descriptions", "info": "One line per size, in variant order.", "default": "Choose 6 proteins (up to 21 lbs)\nChoose 9 proteins (up to 31 lbs)\nChoose 12 proteins (up to 42 lbs)" },
    { "type": "text", "id": "popular_variant", "label": "Popular size name", "default": "Medium" },
    { "type": "text", "id": "frequency_heading", "label": "Frequency heading", "default": "How often do you want a box?" },
    { "type": "text", "id": "frequency_sub", "label": "Frequency subtext", "default": "You can pause or cancel anytime." },
    { "type": "text", "id": "next_text", "label": "Next button", "default": "Next, choose your proteins" },
    { "type": "header", "content": "Step 2: choose cuts" },
    { "type": "text", "id": "cuts_heading", "label": "Heading", "default": "Choose Your Proteins" },
    { "type": "metaobject_list", "id": "cuts_list", "label": "Meat cuts to show", "metaobject_type": "meat_cuts", "info": "Leave empty to show every Meat Cuts entry." },
    { "type": "text", "id": "category_order", "label": "Category order", "info": "Comma separated. Categories come from the Meat Cuts category field; any not listed are added after.", "default": "Member Favorites,Beef,Poultry,Pork,Seafood,More" },
    { "type": "text", "id": "review_text", "label": "Review button", "default": "Review box" },
