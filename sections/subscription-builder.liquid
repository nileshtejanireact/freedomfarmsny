    { "type": "text", "id": "property_name", "label": "Cart property name", "info": "The card chosen on the Get Started page is saved on the cart item under this name.", "default": "Free Offer" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf9f7" },
    { "type": "color", "id": "text_color", "label": "Text and dark button", "default": "#1c2321" },
    { "type": "color", "id": "button_color", "label": "Accent", "default": "#3a9468" }
  ],
  "presets": [{ "name": "Subscription builder" }]
}
