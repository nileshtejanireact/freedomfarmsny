{%- assign sid = section.id -%}
<div class="hl hl-{{ sid }}" id="hl-{{ sid }}">
  <style>
    .hl-{{ sid }} {
      --hl-navy: {{ section.settings.navy }};
      --hl-red: {{ section.settings.red }};
      --hl-cream: {{ section.settings.cream }};
      --hl-text: #1c2321;
      font-family: Karla, Arial, sans-serif;
      color: var(--hl-text);
      background: #fff;
    }
    .hl-{{ sid }} *, .hl-{{ sid }} *::before, .hl-{{ sid }} *::after { box-sizing: border-box; }
    .hl-{{ sid }} .hl__wrap { max-width: 1240px; margin: 0 auto; padding: 0 24px; }
    .hl-{{ sid }} .hl__h { display: block !important; visibility: visible !important; opacity: 1 !important; font-family: Oswald, Impact, 'Arial Narrow', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; line-height: 1.05; margin: 0; }
    .hl-{{ sid }} .hl__eyebrow { display: block; font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 20px; letter-spacing: 6px; text-transform: uppercase; color: var(--hl-red); margin-bottom: 14px; }
    .hl-{{ sid }} .hl__btn { display: inline-block; padding: 18px 34px; border: 2px solid transparent; border-radius: 0; font-family: Oswald, Impact, sans-serif; font-size: 20px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; text-decoration: none !important; cursor: pointer; transition: transform .15s, filter .15s; }
    .hl-{{ sid }} .hl__btn:hover { transform: translateY(-2px); filter: brightness(1.08); }
    .hl-{{ sid }} .hl__btn--red { background: var(--hl-red); color: #fff !important; }
    .hl-{{ sid }} .hl__btn--ghost { background: transparent; color: #fff !important; border-color: #fff; }
    .hl-{{ sid }} .hl__btn--navy { background: var(--hl-navy); color: #fff !important; }

    /* announcement */
    .hl-{{ sid }} .hl__bar { background: var(--hl-red); color: #fff; text-align: center; padding: 12px 16px; font-family: Oswald, Impact, sans-serif; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; font-size: 18px; }

    /* hero */
    .hl-{{ sid }} .hl__hero { position: relative; background: var(--hl-navy); color: var(--hl-cream); overflow: hidden; }
    .hl-{{ sid }} .hl__hero-bg { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: {{ section.settings.hero_overlay | divided_by: 100.0 }}; }
    .hl-{{ sid }} .hl__hero::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 15% 20%, rgba(200,35,44,.28), transparent 45%), radial-gradient(circle at 90% 80%, rgba(255,255,255,.07), transparent 40%); }
    .hl-{{ sid }} .hl__hero-in { position: relative; padding: 110px 24px 120px; max-width: 980px; margin: 0 auto; text-align: center; }
    .hl-{{ sid }} .hl__hero .hl__eyebrow { color: #f2b8bb; }
    .hl-{{ sid }} .hl__hero-h { font-size: 96px; color: var(--hl-cream) !important; margin-bottom: 24px; text-shadow: 0 6px 30px rgba(0,0,0,.4); }
    .hl-{{ sid }} .hl__hero-p { font-size: 22px; line-height: 1.55; max-width: 720px; margin: 0 auto 38px; color: #e9e4d6; }
    .hl-{{ sid }} .hl__ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .hl-{{ sid }} .hl__stripe { height: 10px; background: repeating-linear-gradient(90deg, var(--hl-red) 0 60px, var(--hl-cream) 60px 120px, var(--hl-navy) 120px 180px); }

    /* trust */
    .hl-{{ sid }} .hl__trust { background: var(--hl-cream); border-bottom: 1px solid #e6dfcc; }
    .hl-{{ sid }} .hl__trust-g { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding: 28px 24px; max-width: 1240px; margin: 0 auto; }
    .hl-{{ sid }} .hl__trust-i { text-align: center; font-family: Oswald, Impact, sans-serif; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; font-size: 19px; color: var(--hl-navy); line-height: 1.3; }
    .hl-{{ sid }} .hl__trust-i small { display: block; font-family: Karla, Arial, sans-serif; font-weight: 400; letter-spacing: 0; text-transform: none; font-size: 15px; color: #555; margin-top: 4px; }

    /* sections */
    .hl-{{ sid }} .hl__sec { padding: 84px 0; }
    .hl-{{ sid }} .hl__sec-h { font-size: 52px; color: var(--hl-navy) !important; margin-bottom: 14px; text-align: center; }
    .hl-{{ sid }} .hl__sec-p { font-size: 19px; line-height: 1.55; text-align: center; max-width: 680px; margin: 0 auto 40px; color: #444; }

    /* filters */
    .hl-{{ sid }} .hl__chips { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }
    .hl-{{ sid }} .hl__chip { padding: 12px 24px; border: 2px solid var(--hl-navy); background: #fff; color: var(--hl-navy); font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 17px; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; }
    .hl-{{ sid }} .hl__chip[aria-pressed="true"] { background: var(--hl-navy); color: #fff; }

    /* product grid */
    .hl-{{ sid }} .hl__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
    .hl-{{ sid }} .hl__card { display: flex; flex-direction: column; background: #fff; border: 1px solid #e8e4da; transition: box-shadow .2s, transform .2s; }
    .hl-{{ sid }} .hl__card:hover { box-shadow: 0 14px 34px rgba(11,26,51,.14); transform: translateY(-3px); }
    .hl-{{ sid }} .hl__card[hidden] { display: none; }
    .hl-{{ sid }} .hl__img { position: relative; display: block; aspect-ratio: 1 / 1; background: #f3efe5; overflow: hidden; }
    .hl-{{ sid }} .hl__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
    .hl-{{ sid }} .hl__card:hover .hl__img img { transform: scale(1.05); }
    .hl-{{ sid }} .hl__tag { position: absolute; top: 12px; left: 12px; background: var(--hl-red); color: #fff; font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 15px; letter-spacing: 1.5px; text-transform: uppercase; padding: 5px 12px; }
    .hl-{{ sid }} .hl__tag--out { background: #666; }
    .hl-{{ sid }} .hl__body { padding: 18px 18px 20px; display: flex; flex-direction: column; flex: 1; }
    .hl-{{ sid }} .hl__name { display: block; font-size: 18px; font-weight: 700; line-height: 1.35; color: var(--hl-text) !important; text-decoration: none !important; margin-bottom: 10px; }
    .hl-{{ sid }} .hl__price { font-size: 22px; font-weight: 700; color: var(--hl-navy); margin-bottom: 16px; }
    .hl-{{ sid }} .hl__price s { font-size: 16px; font-weight: 400; color: #888; margin-left: 8px; }
    .hl-{{ sid }} .hl__act { margin-top: auto; }
    .hl-{{ sid }} .hl__add, .hl-{{ sid }} .hl__view { display: block; width: 100%; text-align: center; padding: 14px; border: 2px solid var(--hl-navy); background: var(--hl-navy); color: #fff !important; font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 17px; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; text-decoration: none !important; }
    .hl-{{ sid }} .hl__view { background: #fff; color: var(--hl-navy) !important; }
    .hl-{{ sid }} .hl__add:hover { background: var(--hl-red); border-color: var(--hl-red); }
    .hl-{{ sid }} .hl__add:disabled { opacity: .6; cursor: default; }
    .hl-{{ sid }} .hl__add.is-done { background: #2f7d4f; border-color: #2f7d4f; }
    .hl-{{ sid }} .hl__empty { text-align: center; padding: 40px 0; font-size: 19px; }
    .hl-{{ sid }} .hl__pager { margin-top: 40px; text-align: center; }

    /* gift card band */
    .hl-{{ sid }} .hl__gift { background: var(--hl-navy); color: var(--hl-cream); text-align: center; padding: 84px 24px; }
    .hl-{{ sid }} .hl__gift .hl__sec-h { color: var(--hl-cream) !important; }
    .hl-{{ sid }} .hl__gift .hl__sec-p { color: #d8d2c0; }

    /* steps */
    .hl-{{ sid }} .hl__steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .hl-{{ sid }} .hl__step { text-align: center; padding: 0 12px; }
    .hl-{{ sid }} .hl__num { display: inline-flex; width: 72px; height: 72px; border-radius: 50%; background: var(--hl-red); color: #fff; align-items: center; justify-content: center; font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 34px; margin-bottom: 18px; }
    .hl-{{ sid }} .hl__step-h { font-size: 28px; color: var(--hl-navy) !important; margin-bottom: 10px; }
    .hl-{{ sid }} .hl__step p { font-size: 18px; line-height: 1.55; color: #444; margin: 0; }

    /* faq */
    .hl-{{ sid }} .hl__faq { max-width: 820px; margin: 0 auto; }
    .hl-{{ sid }} .hl__faq details { border: 1px solid #e0dbcc; background: #fff; margin-bottom: 12px; }
    .hl-{{ sid }} .hl__faq summary { list-style: none; cursor: pointer; padding: 22px 56px 22px 24px; font-size: 19px; font-weight: 700; position: relative; }
    .hl-{{ sid }} .hl__faq summary::-webkit-details-marker { display: none; }
    .hl-{{ sid }} .hl__faq summary::after { content: "+"; position: absolute; right: 24px; top: 50%; transform: translateY(-50%); font-size: 28px; color: var(--hl-red); }
    .hl-{{ sid }} .hl__faq details[open] summary::after { content: "\2212"; }
    .hl-{{ sid }} .hl__faq .hl__ans { padding: 0 24px 22px; font-size: 17px; line-height: 1.6; color: #444; }
    .hl-{{ sid }} .hl__faq .hl__ans p { margin: 0 0 10px; }
    .hl-{{ sid }} .hl__bgc { background: var(--hl-cream); }

    /* final cta */
    .hl-{{ sid }} .hl__final { background: var(--hl-red); color: #fff; text-align: center; padding: 84px 24px; }
    .hl-{{ sid }} .hl__final .hl__sec-h { color: #fff !important; }
    .hl-{{ sid }} .hl__final .hl__sec-p { color: #ffe4e5; }
    .hl-{{ sid }} .hl__final .hl__btn { background: #fff; color: var(--hl-red) !important; }


    /* countdown */
    .hl-{{ sid }} .hl__count { background: #fff; color: var(--hl-red); border-bottom: 1px solid #e6dfcc; }
    .hl-{{ sid }} .hl__count[hidden] { display: none; }
    .hl-{{ sid }} .hl__count-in { max-width: 1240px; margin: 0 auto; padding: 18px 24px; display: flex; align-items: center; justify-content: center; gap: 28px; flex-wrap: wrap; }
    .hl-{{ sid }} .hl__count-l { font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 24px; letter-spacing: 3px; text-transform: uppercase; }
    .hl-{{ sid }} .hl__time { display: flex; gap: 10px; }
    .hl-{{ sid }} .hl__unit { min-width: 82px; text-align: center; background: rgba(11,26,51,.92); padding: 8px 10px 6px; }
    .hl-{{ sid }} .hl__unit b { color: #fff; display: block; font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 38px; line-height: 1.1; font-variant-numeric: tabular-nums; }
    .hl-{{ sid }} .hl__unit span { display: block; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #f2b8bb; }
    @media (max-width: 800px) {
      .hl-{{ sid }} .hl__count-l { font-size: 17px; letter-spacing: 2px; text-align: center; }
      .hl-{{ sid }} .hl__count-in { gap: 10px; padding: 14px 16px; }
      .hl-{{ sid }} .hl__unit { min-width: 66px; }
      .hl-{{ sid }} .hl__unit b { font-size: 28px; }
        }

    /* polish */
    .hl-{{ sid }} .hl__trust-ic { display: block; width: 38px; height: 38px; margin: 0 auto 10px; stroke: var(--hl-red); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .hl-{{ sid }} .hl__tools { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 32px; }
    .hl-{{ sid }} .hl__tools .hl__chips { margin: 0; justify-content: flex-start; }
    .hl-{{ sid }} .hl__sort { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 700; color: var(--hl-navy); }
    .hl-{{ sid }} .hl__sort select { height: 46px; padding: 0 38px 0 14px; border: 2px solid var(--hl-navy); border-radius: 0; background: #fff; color: var(--hl-navy); font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 16px; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; }
    .hl-{{ sid }} .hl__pager { font-size: 0; }
    .hl-{{ sid }} .hl__pager span, .hl-{{ sid }} .hl__pager a { display: inline-block; min-width: 46px; height: 46px; line-height: 42px; margin: 0 4px; padding: 0 14px; border: 2px solid var(--hl-navy); color: var(--hl-navy) !important; font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 18px; text-decoration: none !important; text-align: center; background: #fff; }
    .hl-{{ sid }} .hl__pager span > a { margin: 0; border: 0; min-width: 0; height: auto; line-height: inherit; padding: 0; background: none; }
    .hl-{{ sid }} .hl__pager .current { background: var(--hl-navy); color: #fff !important; }
    .hl-{{ sid }} .hl__toast { position: fixed; left: 50%; bottom: 70px; transform: translate(-50%, 30px); z-index: 99999; background: var(--hl-navy); color: #fff; padding: 14px 20px; display: flex; align-items: center; gap: 18px; box-shadow: 0 12px 40px rgba(0,0,0,.35); border-left: 6px solid #2f7d4f; opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s; max-width: calc(100vw - 24px); font-size: 16px; }
    .hl-{{ sid }} .hl__toast.is-on { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
    .hl-{{ sid }} .hl__toast a { color: #fff !important; background: var(--hl-red); padding: 8px 16px; font-family: Oswald, Impact, sans-serif; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; text-decoration: none !important; white-space: nowrap; }
    .hl-{{ sid }} .hl__sec, .hl-{{ sid }} .hl__gift { scroll-margin-top: 20px; }
    @media (max-width: 800px) {
      .hl-{{ sid }} .hl__tools { flex-direction: column; align-items: stretch; gap: 14px; }
      .hl-{{ sid }} .hl__tools .hl__chips { justify-content: center; }
      .hl-{{ sid }} .hl__sort { justify-content: center; }
      .hl-{{ sid }} .hl__trust-ic { width: 30px; height: 30px; }
    }
    @media (max-width: 1100px) { .hl-{{ sid }} .hl__grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 800px) {
      .hl-{{ sid }} .hl__hero-in { padding: 70px 20px 80px; }
      .hl-{{ sid }} .hl__hero-h { font-size: 52px; }
      .hl-{{ sid }} .hl__hero-p { font-size: 18px; }
      .hl-{{ sid }} .hl__trust-g { grid-template-columns: repeat(2, 1fr); }
      .hl-{{ sid }} .hl__sec { padding: 56px 0; }
      .hl-{{ sid }} .hl__sec-h { font-size: 36px; }
      .hl-{{ sid }} .hl__grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
      .hl-{{ sid }} .hl__name { font-size: 15px; }
      .hl-{{ sid }} .hl__price { font-size: 18px; }
      .hl-{{ sid }} .hl__body { padding: 12px 12px 14px; }
      .hl-{{ sid }} .hl__add, .hl-{{ sid }} .hl__view { font-size: 14px; padding: 12px 6px; letter-spacing: 1px; }
      .hl-{{ sid }} .hl__steps { grid-template-columns: 1fr; gap: 36px; }
      .hl-{{ sid }} .hl__chips { gap: 8px; }
      .hl-{{ sid }} .hl__chip { padding: 10px 14px; font-size: 14px; letter-spacing: 1px; }
      .hl-{{ sid }} .hl__gift, .hl-{{ sid }} .hl__final { padding: 56px 20px; }
    }
  </style>

  {%- if section.settings.bar_text != blank -%}
    <div class="hl__bar">{{ section.settings.bar_text | escape }}</div>
  {%- endif -%}

  <section class="hl__hero">
    {%- if section.settings.hero_image != blank -%}
      <div class="hl__hero-bg" style="background-image:url('{{ section.settings.hero_image | image_url: width: 2400 }}')"></div>
    {%- endif -%}
    <div class="hl__hero-in">
      <span class="hl__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      <span class="hl__h hl__hero-h" role="heading" aria-level="1">{{ section.settings.heading | escape }}</span>
      <p class="hl__hero-p">{{ section.settings.subheading | escape }}</p>
      <div class="hl__ctas">
        <a class="hl__btn hl__btn--red" href="#hl-shop-{{ sid }}">{{ section.settings.cta_primary | escape }}</a>
        {%- if section.settings.cta_secondary != blank -%}
          {%- assign gift_anchor = '#hl-gift-' | append: sid -%}
          <a class="hl__btn hl__btn--ghost" href="{{ section.settings.cta_secondary_link | default: gift_anchor }}">{{ section.settings.cta_secondary | escape }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="hl__stripe"></div>
  </section>

  {%- if section.settings.countdown_end != blank -%}
    {%- assign tz = 'now' | date: '%z' -%}
    {%- assign tz_h = tz | slice: 0, 3 -%}
    {%- assign tz_m = tz | slice: 3, 2 -%}
    <div class="hl__count" data-end="{{ section.settings.countdown_end | strip | replace: ' ', 'T' }}:00{{ tz_h }}:{{ tz_m }}" data-expired="{{ section.settings.countdown_expired | escape }}" hidden>
      <div class="hl__count-in">
        <span class="hl__count-l">{{ section.settings.countdown_label | escape }}</span>
        <div class="hl__time" aria-live="off">
          <div class="hl__unit"><b data-d>00</b><span>Days</span></div>
          <div class="hl__unit"><b data-h>00</b><span>Hours</span></div>
          <div class="hl__unit"><b data-m>00</b><span>Mins</span></div>
          <div class="hl__unit"><b data-s>00</b><span>Secs</span></div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <section class="hl__trust" aria-label="Why Freedom Farms">
    <div class="hl__trust-g">
      {%- for i in (1..4) -%}
        {%- assign t_key = 'trust_' | append: i -%}
        {%- assign d_key = 'trust_' | append: i | append: '_sub' -%}
        {%- assign t = section.settings[t_key] -%}
        {%- if t != blank -%}
          {%- case i -%}
            {%- when 1 -%}{%- capture ic -%}<path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.5 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/>{%- endcapture -%}
            {%- when 2 -%}{%- capture ic -%}<path d="M3 6h11v10H3zM14 9h4l3 3v4h-7zM7 19a2 2 0 100-4 2 2 0 000 4zM17 19a2 2 0 100-4 2 2 0 000 4z"/>{%- endcapture -%}
            {%- when 3 -%}{%- capture ic -%}<path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>{%- endcapture -%}
            {%- else -%}{%- capture ic -%}<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>{%- endcapture -%}
          {%- endcase -%}
          <div class="hl__trust-i"><svg class="hl__trust-ic" viewBox="0 0 24 24" aria-hidden="true">{{ ic }}</svg>{{ t | escape }}{%- if section.settings[d_key] != blank -%}<small>{{ section.settings[d_key] | escape }}</small>{%- endif -%}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="hl__sec" id="hl-shop-{{ sid }}">
    <div class="hl__wrap">
      <span class="hl__h hl__sec-h" role="heading" aria-level="2">{{ section.settings.shop_heading | escape }}</span>
      <p class="hl__sec-p">{{ section.settings.shop_text | escape }}</p>

      {%- paginate collection.products by section.settings.per_page -%}
        {%- if collection.products.size == 0 -%}
          <p class="hl__empty">No gifts are available right now. Please check back soon.</p>
        {%- else -%}
          <div class="hl__tools">
          <div class="hl__chips" role="group" aria-label="Filter by price">
            <button type="button" class="hl__chip" data-f="all" aria-pressed="true">All gifts</button>
            <button type="button" class="hl__chip" data-f="u100" aria-pressed="false">Under $100</button>
            <button type="button" class="hl__chip" data-f="m200" aria-pressed="false">$100 &ndash; $200</button>
            <button type="button" class="hl__chip" data-f="o200" aria-pressed="false">$200 &amp; up</button>
          </div>
            <label class="hl__sort">Sort
              <select data-sort>
                <option value="featured">Featured</option>
                <option value="low">Price: low to high</option>
                <option value="high">Price: high to low</option>
              </select>
            </label>
          </div>
          <div class="hl__grid" data-grid>
            {%- for product in collection.products -%}
              {%- assign v = product.selected_or_first_available_variant -%}
              {%- assign on_sale = false -%}
              {%- if product.compare_at_price > product.price and product.price > 0 -%}{%- assign on_sale = true -%}{%- endif -%}
              <article class="hl__card" data-price="{{ product.price }}" data-i="{{ forloop.index0 }}">
                <a class="hl__img" href="{{ product.url | within: collection }}" tabindex="-1" aria-hidden="true">
                  {%- if product.featured_image != blank -%}
                    <img src="{{ product.featured_image | image_url: width: 600 }}" srcset="{{ product.featured_image | image_url: width: 360 }} 360w, {{ product.featured_image | image_url: width: 600 }} 600w" sizes="(max-width: 800px) 50vw, 25vw" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="600">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                  {%- unless product.available -%}<span class="hl__tag hl__tag--out">Sold out</span>
                  {%- elsif on_sale -%}<span class="hl__tag">Save {{ product.compare_at_price | minus: product.price | money_without_trailing_zeros }}</span>{%- endunless -%}
                </a>
                <div class="hl__body">
                  <a class="hl__name" href="{{ product.url | within: collection }}">{{ product.title | escape }}</a>
                  <div class="hl__price">{%- if product.price_varies -%}From&nbsp;{%- endif -%}{%- if product.price == 0 and product.price_varies == false -%}Free{%- else -%}{{ product.price | money_without_trailing_zeros }}{%- endif -%}{%- if on_sale -%}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}</div>
                  <div class="hl__act">
                    {%- if product.available and product.variants.size == 1 and product.selling_plan_groups.size == 0 -%}
                      <button type="button" class="hl__add" data-add="{{ v.id }}">Add to cart</button>
                    {%- elsif product.available -%}
                      <a class="hl__view" href="{{ product.url | within: collection }}">Choose options</a>
                    {%- else -%}
                      <a class="hl__view" href="{{ product.url | within: collection }}">View</a>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
          <p class="hl__empty" data-none hidden>No gifts in this price range on this page.</p>
          {%- if paginate.pages > 1 -%}
            <div class="hl__pager">{{ paginate | default_pagination }}</div>
          {%- endif -%}
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </section>

  {%- if section.settings.gift_heading != blank -%}
  <section class="hl__gift" id="hl-gift-{{ sid }}">
    <div class="hl__wrap">
      <span class="hl__h hl__sec-h" role="heading" aria-level="2">{{ section.settings.gift_heading | escape }}</span>
      <p class="hl__sec-p">{{ section.settings.gift_text | escape }}</p>
      <a class="hl__btn hl__btn--red" href="{{ section.settings.gift_link | default: '/collections/gift-cards' }}">{{ section.settings.gift_button | escape }}</a>
    </div>
  </section>
  {%- endif -%}

  <section class="hl__sec">
    <div class="hl__wrap">
      <span class="hl__h hl__sec-h" role="heading" aria-level="2">{{ section.settings.steps_heading | escape }}</span>
      <div class="hl__steps" style="margin-top:40px">
        {%- for i in (1..3) -%}
          {%- assign th = 'step_' | append: i | append: '_title' -%}
          {%- assign tx = 'step_' | append: i | append: '_text' -%}
          <div class="hl__step">
            <span class="hl__num">{{ i }}</span>
            <span class="hl__h hl__step-h" role="heading" aria-level="3">{{ section.settings[th] | escape }}</span>
            <p>{{ section.settings[tx] | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="hl__sec hl__bgc">
    <div class="hl__wrap">
      <span class="hl__h hl__sec-h" role="heading" aria-level="2">{{ section.settings.faq_heading | escape }}</span>
      <div class="hl__faq" style="margin-top:40px">
        {%- for i in (1..4) -%}
          {%- assign fq = 'faq_' | append: i | append: '_q' -%}
          {%- assign fa = 'faq_' | append: i | append: '_a' -%}
          {%- if section.settings[fq] != blank -%}
            <details>
              <summary>{{ section.settings[fq] | escape }}</summary>
              <div class="hl__ans"><p>{{ section.settings[fa] | escape }}</p></div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="hl__final">
    <div class="hl__wrap">
      <span class="hl__h hl__sec-h" role="heading" aria-level="2">{{ section.settings.final_heading | escape }}</span>
      <p class="hl__sec-p">{{ section.settings.final_text | escape }}</p>
      <a class="hl__btn" href="#hl-shop-{{ sid }}">{{ section.settings.final_button | escape }}</a>
    </div>
  </section>
</div>

<script>
  (function () {
    var root = document.getElementById('hl-{{ sid }}');
    if (!root) return;
    var cards = root.querySelectorAll('.hl__card');
    var none = root.querySelector('[data-none]');

    root.querySelectorAll('.hl__chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        var f = chip.getAttribute('data-f'), shown = 0;
        root.querySelectorAll('.hl__chip').forEach(function (c) { c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'); });
        cards.forEach(function (card) {
          var p = parseInt(card.getAttribute('data-price'), 10) / 100;
          var ok = f === 'all' || (f === 'u100' && p < 100) || (f === 'm200' && p >= 100 && p < 200) || (f === 'o200' && p >= 200);
          card.hidden = !ok;
          if (ok) shown++;
        });
        if (none) none.hidden = shown > 0;
      });
    });

    var cnt = root.querySelector('.hl__count');
    if (cnt) {
      var end = Date.parse(cnt.getAttribute('data-end'));
      var expiredText = cnt.getAttribute('data-expired');
      var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
      var tick = function () {
        var left = end - Date.now();
        if (isNaN(end)) { cnt.hidden = true; return; }
        if (left <= 0) {
          if (expiredText) { cnt.querySelector('.hl__time').hidden = true; cnt.querySelector('.hl__count-l').textContent = expiredText; cnt.hidden = false; } else { cnt.hidden = true; }
          return;
        }
        cnt.hidden = false;
        cnt.querySelector('[data-d]').textContent = pad(Math.floor(left / 864e5));
        cnt.querySelector('[data-h]').textContent = pad(Math.floor(left / 36e5) % 24);
        cnt.querySelector('[data-m]').textContent = pad(Math.floor(left / 6e4) % 60);
        cnt.querySelector('[data-s]').textContent = pad(Math.floor(left / 1e3) % 60);
        setTimeout(tick, 1000);
      };
      tick();
    }

    var sortSel = root.querySelector('[data-sort]');
    var gridEl = root.querySelector('[data-grid]');
    if (sortSel && gridEl) {
      sortSel.addEventListener('change', function () {
        var list = Array.prototype.slice.call(gridEl.querySelectorAll('.hl__card'));
        var by = sortSel.value;
        list.sort(function (a, b) {
          if (by === 'featured') return a.getAttribute('data-i') - b.getAttribute('data-i');
          var d = a.getAttribute('data-price') - b.getAttribute('data-price');
          return by === 'low' ? d : -d;
        });
        list.forEach(function (c) { gridEl.appendChild(c); });
      });
    }

    var toast = document.createElement('div');
    toast.className = 'hl__toast';
    toast.setAttribute('role', 'status');
    toast.innerHTML = '<span></span><a href="/cart">View cart</a>';
    root.appendChild(toast);
    var toastTimer;
    function showToast(name) {
      toast.firstChild.textContent = name + ' added to cart';
      toast.classList.add('is-on');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { toast.classList.remove('is-on'); }, 4500);
    }

    root.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-add]');
      if (!btn) return;
      if (btn.classList.contains('is-done')) { window.location.href = '/cart'; return; }
      btn.disabled = true;
      var label = btn.textContent;
      btn.textContent = 'Adding...';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: Number(btn.getAttribute('data-add')), quantity: 1 })
      }).then(function (r) {
        if (!r.ok) throw new Error('add failed');
        btn.classList.add('is-done');
        btn.disabled = false;
        btn.textContent = 'Added ✓ View cart';
        var nm = btn.closest('.hl__card').querySelector('.hl__name');
        showToast(nm ? nm.textContent.trim() : 'Item');
      }).catch(function () {
        btn.disabled = false;
        btn.textContent = label;
        window.location.href = btn.closest('.hl__card').querySelector('.hl__name').href;
      });
    });
  })();
</script>

