{%- assign sid = section.id -%}
{%- assign hero_image = section.settings.hero_image | default: collection.image -%}
{%- assign hero_title = section.settings.hero_title | default: collection.title -%}
{%- assign product_anchor = section.settings.product_anchor | default: 'holiday-gifts-products' -%}
<section class="holiday-gifts holiday-gifts-{{ sid }}">
  <style>
    .holiday-gifts-{{ sid }} {
      --hg-forest: {{ section.settings.forest_color }};
      --hg-cream: {{ section.settings.highlights_background }};
      color: {{ section.settings.body_color }};
    }
    .holiday-gifts-{{ sid }} .hg-hero {
      align-items: center;
      background-color: {{ section.settings.hero_background }};
      color: {{ section.settings.hero_text_color }};
      display: flex;
      min-height: {{ section.settings.hero_height }}px;
      overflow: hidden;
      padding: 72px 24px;
      position: relative;
    }
    .holiday-gifts-{{ sid }} .hg-hero__image,
    .holiday-gifts-{{ sid }} .hg-hero__shade {
      height: 100%;
      inset: 0;
      position: absolute;
      width: 100%;
    }
    .holiday-gifts-{{ sid }} .hg-hero__image { object-fit: cover; object-position: center; }
    .holiday-gifts-{{ sid }} .hg-hero__shade {
      background: linear-gradient(90deg, rgba(15, 32, 22, {{ section.settings.overlay_opacity | divided_by: 100.0 }}), rgba(15, 32, 22, .1));
    }
    .holiday-gifts-{{ sid }} .hg-hero__content {
      margin: 0 auto;
      max-width: {{ section.settings.content_width }}px;
      position: relative;
      width: 100%;
    }
    .holiday-gifts-{{ sid }} .hg-eyebrow {
      color: {{ section.settings.eyebrow_color }};
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .2em;
      margin: 0 0 14px;
      text-transform: uppercase;
    }
    .holiday-gifts-{{ sid }} .hg-hero h1 {
      color: inherit;
      font-size: clamp(42px, 7vw, {{ section.settings.heading_size }}px);
      font-weight: 700;
      letter-spacing: .02em;
      line-height: 1.02;
      margin: 0 0 18px;
      max-width: 720px;
    }
    .holiday-gifts-{{ sid }} .hg-hero__copy { font-size: 18px; line-height: 1.65; margin: 0 0 28px; max-width: 560px; }
    .holiday-gifts-{{ sid }} .hg-button {
      background: {{ section.settings.button_background }};
      border: 1px solid {{ section.settings.button_background }};
      border-radius: 2px;
      color: {{ section.settings.button_text_color }};
      display: inline-block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .12em;
      padding: 15px 24px;
      text-decoration: none;
      text-transform: uppercase;
      transition: background .2s ease, color .2s ease;
    }
    .holiday-gifts-{{ sid }} .hg-button:hover,
    .holiday-gifts-{{ sid }} .hg-button:focus { background: transparent; color: {{ section.settings.hero_text_color }}; }
    .holiday-gifts-{{ sid }} .hg-highlights {
      background: var(--hg-cream);
      display: grid;
      gap: 18px;
      grid-template-columns: repeat({{ section.settings.highlight_columns }}, minmax(0, 1fr));
      margin: 0 auto 54px;
      max-width: 1200px;
      padding: 24px;
      text-align: center;
    }
    .holiday-gifts-{{ sid }} .hg-highlight {
      color: var(--hg-forest);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: .06em;
      line-height: 1.5;
      text-transform: uppercase;
    }
    .holiday-gifts-{{ sid }} .hg-intro { margin: 0 auto; max-width: 720px; padding: 56px 24px 24px; text-align: center; }
    .holiday-gifts-{{ sid }} .hg-intro__eyebrow { color: {{ section.settings.eyebrow_color }}; font-size: 11px; font-weight: 700; letter-spacing: .18em; margin: 0 0 12px; text-transform: uppercase; }
    .holiday-gifts-{{ sid }} .hg-intro h2 { color: var(--hg-forest); font-size: clamp(26px, 4vw, 38px); line-height: 1.2; margin: 0 0 14px; }
    .holiday-gifts-{{ sid }} .hg-intro__copy { font-size: 16px; line-height: 1.7; margin: 0; }
    .holiday-gifts-{{ sid }} .hg-products { scroll-margin-top: 40px; }
    @media (max-width: 767px) {
      .holiday-gifts-{{ sid }} .hg-hero { min-height: 390px; padding: 58px 22px; }
      .holiday-gifts-{{ sid }} .hg-hero__shade { background: rgba(15, 32, 22, {{ section.settings.mobile_overlay_opacity | divided_by: 100.0 }}); }
      .holiday-gifts-{{ sid }} .hg-hero__copy { font-size: 16px; }
      .holiday-gifts-{{ sid }} .hg-highlights { gap: 10px; grid-template-columns: 1fr; margin-bottom: 32px; padding: 20px; }
      .holiday-gifts-{{ sid }} .hg-intro { padding-top: 36px; }
    }
  </style>

  <div class="hg-hero">
    {%- if hero_image != blank -%}
      <img class="hg-hero__image" src="{{ hero_image | image_url: width: 2000 }}" alt="{{ hero_image.alt | escape }}" loading="eager" width="{{ hero_image.width }}" height="{{ hero_image.height }}">
    {%- endif -%}
    <div class="hg-hero__shade" aria-hidden="true"></div>
    <div class="hg-hero__content">
      {%- if section.settings.hero_eyebrow != blank -%}<p class="hg-eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>{%- endif -%}
      {%- if hero_title != blank -%}<h1>{{ hero_title | escape }}</h1>{%- endif -%}
      {%- if section.settings.hero_copy != blank -%}<p class="hg-hero__copy">{{ section.settings.hero_copy | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="hg-button" href="{{ section.settings.button_link | default: '#' | escape }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="hg-highlights" aria-label="{{ section.settings.highlights_label | escape }}">
      {%- for block in section.blocks -%}
        <div class="hg-highlight" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_intro -%}
    <div class="hg-intro">
      {%- if section.settings.intro_eyebrow != blank -%}<p class="hg-intro__eyebrow">{{ section.settings.intro_eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.intro_heading != blank -%}<h2>{{ section.settings.intro_heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.intro_copy != blank -%}<p class="hg-intro__copy">{{ section.settings.intro_copy | escape }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div id="{{ product_anchor | handleize }}" class="hg-products">
    {%- render 'collection_grid' -%}
  </div>
</section>

{% schema %}
{
  "name": "Holiday Gifts landing",
  "settings": [
    { "type": "header", "content": "Hero content" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Falls back to the collection image when left blank." },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "The Freedom Farms Gift Guide" },
    { "type": "text", "id": "hero_title", "label": "Heading", "default": "Holiday Gifts" },
    { "type": "textarea", "id": "hero_copy", "label": "Description", "default": "Give them something delicious to gather around. Find a memorable holiday gift for the people who make every meal special." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop holiday gifts" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "#holiday-gifts-products" },
    { "type": "text", "id": "product_anchor", "label": "Product section anchor", "default": "holiday-gifts-products" },
    { "type": "header", "content": "Highlights and intro" },
    { "type": "text", "id": "highlights_label", "label": "Highlights accessibility label", "default": "Holiday gift highlights" },
    { "type": "select", "id": "highlight_columns", "label": "Highlight columns", "default": "3", "options": [{ "value": "2", "label": "2 columns" }, { "value": "3", "label": "3 columns" }, { "value": "4", "label": "4 columns" }] },
    { "type": "checkbox", "id": "show_intro", "label": "Show intro section", "default": true },
    { "type": "text", "id": "intro_eyebrow", "label": "Intro eyebrow", "default": "Make it a meal to remember" },
    { "type": "text", "id": "intro_heading", "label": "Intro heading", "default": "Bring a little more joy to the table" },
    { "type": "textarea", "id": "intro_copy", "label": "Intro text", "default": "From festive feasts to cozy nights in, explore gifts made for sharing good food and good company." },
    { "type": "header", "content": "Layout and colors" },
    { "type": "range", "id": "hero_height", "label": "Hero height", "min": 300, "max": 700, "step": 20, "unit": "px", "default": 440 },
    { "type": "range", "id": "heading_size", "label": "Maximum heading size", "min": 48, "max": 96, "step": 2, "unit": "px", "default": 76 },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 800, "max": 1400, "step": 50, "unit": "px", "default": 1200 },
    { "type": "range", "id": "overlay_opacity", "label": "Desktop image overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 65 },
    { "type": "range", "id": "mobile_overlay_opacity", "label": "Mobile image overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 60 },
    { "type": "color", "id": "hero_background", "label": "Hero fallback background", "default": "#273c2c" },
    { "type": "color", "id": "hero_text_color", "label": "Hero text", "default": "#ffffff" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow and accent", "default": "#f3d9a1" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#f3d9a1" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#203b2c" },
    { "type": "color", "id": "forest_color", "label": "Section heading and highlight text", "default": "#173c2b" },
    { "type": "color", "id": "highlights_background", "label": "Highlights background", "default": "#f7f3e8" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#242820" }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Thoughtful gifts for food lovers" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Holiday Gifts landing",
      "blocks": [
        { "type": "highlight", "settings": { "text": "A centerpiece worth sharing" } },
        { "type": "highlight", "settings": { "text": "Thoughtful gifts for food lovers" } },
        { "type": "highlight", "settings": { "text": "Make the holidays delicious" } }
      ]
    }
  ]
}
{% endschema %}
