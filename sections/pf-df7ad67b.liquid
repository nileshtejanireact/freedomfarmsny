 from the farm!! Great meats and great service!!!"</span></p></div></div></div>{% endform %}{% endif %}{% assign product = defaultProduct %}</div><div data-pf-type="Custom.HTML" class="sc-lbJdeI bvzyhN pf-269_"><script>
let userPaused = new WeakSet();
let userMuted = new WeakSet();

document.querySelectorAll('.pf-media-wrapper video').forEach(video => {

  video.setAttribute('playsinline', '');
  video.muted = true; // autoplay ke liye start muted

  video.play().catch(()=>{});

  // Track pause
  video.addEventListener('pause', () => {
    if (video.closest('.pf-slide-main-media.is-current')) {
      userPaused.add(video);
    }
  });

  video.addEventListener('play', () => {
    userPaused.delete(video);
  });

  // Track mute/unmute via controls
  video.addEventListener('volumechange', () => {
    if (video.muted) {
      userMuted.add(video);
    } else {
      userMuted.delete(video);
    }
  });

});

setInterval(() => {
  document.querySelectorAll('.pf-media-wrapper video').forEach(video => {

    let isActive = video.closest('.pf-slide-main-media.is-current');

    if (isActive) {

      // ▶️ Play if needed
      if (!userPaused.has(video) && video.paused) {
        video.play().catch(()=>{});
      }

      // 🔊 Unmute only if user ne mute nahi kiya
      if (!userMuted.has(video)) {
        video.muted = false;
      }

    } else {
      // ⛔ Background videos
      video.pause();
      video.muted = true;
      userPaused.delete(video);
    }

  });
}, 800); // thoda fast response
</script></div></div></section><section data-section-id="pf-55e8" data-pf-type="FlexSection" class="sc-cKXyOM gdMpOS pf-270_ pf-container-1 pf-lg-hide pf-md-hide pf-sm-hide pf-hide"><div class="sc-bHnkpz ffFBJG pf-flex-section"><img alt="ASeen.png__PID:d46d9a74-b641-462e-ba88-b043af96278e" src="https://cdn.shopify.com/s/files/1/0529/2376/0823/files/ASeen.png?v=1766618866&width=2048" srcSet="https://cdn.shopify.com/s/files/1/0529/2376/0823/files/ASeen.png?v=1766618866&width=375 375w,https://cdn.shopify.com/s/files/1/0529/2376/0823/files/ASeen.png?v=1766618866&width=550 550w,https://cdn.shopify.com/s/files/1/0529/2376/0823/files/ASeen.png?v=1766618866&width=768 768w,https://cdn.shopify.com/s/files/1/0529/2376/0823/files/ASeen.png?v=1766618866&width=1024 1024w,https://cdn.shopify.com/s/files/1/0529/2376/0823/files/ASeen.png?v=1766618866&width=1280 1280w,https://cdn.shopify.com/s/files/1/0529/2376/0823/files/ASeen.png?v=1766618866&width=1440 1440w,https://cdn.shopify.com/s/files/1/0529/2376/0823/files/ASeen.png?v=1766618866&width=1680 1680w,https://cdn.shopify.com/s/files/1/0529/2376/0823/files/ASeen.png?v=1766618866&width=1800 1800w,https://cdn.shopify.com/s/files/1/0529/2376/0823/files/ASeen.png?v=1766618866&width=1920 1920w,https://cdn.shopify.com/s/files/1/0529/2376/0823/files/ASeen.png?v=1766618866&width=2048 2048w" fetchPriority="low" decoding="async" loading="lazy" style="--pf-image-ratio:4.8" sizes="75vw" data-pf-type="Image5" class="sc-jwZJYP clbmpw pf-271_ pf-hide" store="[object Object]"/></div></section><section data-section-id="pf-73da" data-pf-type="FlexSection" class="sc-cKXyOM gdMpOS pf-272_ pf-container-1 pf-lg-hide pf-hide"><div class="sc-bHnkpz ffFBJG pf-flex-section"><div data-pf-type="FlexBlock" class="sc-kpKSlO brELaQ pf-273_"><img alt="WhatsApp Image 2026-05-18 at 8.21.21 AM.jpeg__PID:986587bb-0ec0-4f75-bd9d-58fa25035cbf" src="https://cdn.shopify.com/s/files/1/0529/2376/0823/files/WhatsApp_Image_2026-05-18_at_8.21.21_AM.jpg?v=1779084849&width=2048