{%- assign sid = section.id -%}
<section class="ps ps-{{ sid }}" id="ps-{{ sid }}" aria-label="{{ section.settings.heading | escape }}">
  <style>
    .ps-{{ sid }} {
      --ps-navy: {{ section.settings.navy }};
      --ps-red: {{ section.settings.red }};
      --ps-bg: {{ section.settings.bg }};
      position: relative;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      max-width: 100vw;
      background: var(--ps-bg);
      font-family: Karla, Arial, sans-serif;
      padding: 64px 24px 70px;
      overflow: hidden;
    }
    .ps-{{ sid }} *, .ps-{{ sid }} *::before, .ps-{{ sid }} *::after { box-sizing: border-box; }
    .ps-{{ sid }} .ps__in { max-width: {% if section.blocks.size > 3 %}1240{% else %}1080{% endif %}px; margin: 0 auto; text-align: center; }
    .ps-{{ sid }} .ps__eyebrow { display: flex; align-items: center; justify-content: center; gap: 16px; font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 17px; letter-spacing: 6px; text-transform: uppercase; color: var(--ps-red); margin-bottom: 14px; }
    .ps-{{ sid }} .ps__eyebrow::before, .ps-{{ sid }} .ps__eyebrow::after { content: ""; width: 70px; height: 3px; background: var(--ps-red); border-radius: 2px; }
    .ps-{{ sid }} .ps__h { display: block !important; visibility: visible !important; opacity: 1 !important; font-family: Oswald, Impact, 'Arial Narrow', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; line-height: 1.05; margin: 0 0 36px; font-size: 56px; color: var(--ps-navy) !important; }
    .ps-{{ sid }} .ps__h { text-wrap: balance; }
    .ps-{{ sid }} .ps__card { display: flex; align-items: stretch; justify-content: center; background: #fff; border: 1px solid #ece5d2; border-radius: 16px; box-shadow: 0 10px 34px rgba(11, 26, 51, .09); overflow: hidden; }
    .ps-{{ sid }} .ps__cell { flex: 1 1 0; display: flex; align-items: center; justify-content: center; padding: 38px 28px; min-width: 0; text-decoration: none !important; transition: background .2s ease; }
    .ps-{{ sid }} .ps__cell + .ps__cell { border-left: 1px solid #efe9d8; }
    .ps-{{ sid }} a.ps__cell:hover { background: #fffaf2; }
    .ps-{{ sid }} .ps__logo { display: block; height: calc(var(--ps-h, 52px) * var(--ps-s, 1)); width: auto; max-width: 100%; object-fit: contain; filter: brightness(.82); opacity: .9; transition: filter .25s ease, opacity .25s ease, transform .25s ease; }
    .ps-{{ sid }} .ps__cell:hover .ps__logo { filter: brightness(.45); opacity: 1; transform: translateY(-2px) scale(1.03); }
    .ps-{{ sid }} .ps__note { margin: 24px 0 0; font-size: 15px; color: #6b6b62 !important; font-family: Karla, Arial, sans-serif !important; }
    @media (max-width: 820px) {
      .ps-{{ sid }} { padding: 48px 16px 54px; }
      .ps-{{ sid }} .ps__h { font-size: 38px; margin-bottom: 26px; }
      .ps-{{ sid }} .ps__eyebrow { font-size: 14px; letter-spacing: 4px; gap: 10px; }
      .ps-{{ sid }} .ps__eyebrow::before, .ps-{{ sid }} .ps__eyebrow::after { width: 34px; }
      .ps-{{ sid }} .ps__card { flex-wrap: wrap; }
      .ps-{{ sid }} .ps__cell { flex: 1 1 50%; padding: 26px 16px; border-left: 0 !important; }
      .ps-{{ sid }} .ps__cell:nth-child(n+3) { border-top: 1px solid #efe9d8; }
      .ps-{{ sid }} .ps__cell:nth-child(odd):not(:last-child) { border-right: 1px solid #efe9d8; }
      .ps-{{ sid }} .ps__cell:last-child:nth-child(odd) { flex-basis: 100%; }
      .ps-{{ sid }} .ps__logo { height: calc(var(--ps-h, 52px) * var(--ps-s, 1) * .78); }
    }
  </style>

  <div class="ps__in">
    {%- if section.settings.eyebrow != blank -%}<div class="ps__eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
    <span class="ps__h" role="heading" aria-level="2">{{ section.settings.heading | escape }}</span>
    <div class="ps__card" style="--ps-h: {{ section.settings.logo_height }}px">
      {%- for block in section.blocks -%}
        {%- assign tag = 'div' -%}
        {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
        <{{ tag }} class="ps__cell" {% if block.settings.link != blank %}href="{{ block.settings.link }}" target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }} style="--ps-s: {{ block.settings.size | divided_by: 100.0 }}">
          {%- if block.settings.asset_file != blank -%}
            <img class="ps__logo" src="{{ block.settings.asset_file | asset_url }}" alt="{{ block.settings.alt | escape }}" loading="lazy">
          {%- elsif block.settings.image != blank -%}
            <img class="ps__logo" src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.alt | default: block.settings.image.alt | escape }}" loading="lazy">
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="ps__note">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Press strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "info": "Leave empty to hide.", "default": "As seen on" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We Are Freedom Farms" },
    { "type": "text", "id": "note", "label": "Small line under the logos", "info": "Leave empty to hide." },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 30, "max": 90, "step": 2, "unit": "px", "default": 52 },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "navy", "label": "Heading colour", "default": "#0b1a33" },
    { "type": "color", "id": "red", "label": "Accent", "default": "#c8232c" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#fdf5ea" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "asset_file", "label": "Logo from theme files (optional)", "info": "File name of a picture in the theme's assets. It is shown instead of the image above." },
        { "type": "text", "id": "alt", "label": "Name (for accessibility)" },
        { "type": "url", "id": "link", "label": "Link (optional)", "info": "Opens in a new tab, for example the article." },
        { "type": "range", "id": "size", "label": "Relative size", "min": 60, "max": 220, "step": 5, "unit": "%", "default": 100 }
      ]
    }
  ],
  "presets": [{ "name": "Press strip" }]
}
{% endschema %}
