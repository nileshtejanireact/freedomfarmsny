{%- assign sid = section.id -%}
<div class="cp cp-{{ sid }}" id="cp-{{ sid }}">
  <style>
    .cp-{{ sid }} { --navy: {{ section.settings.navy }}; --red: {{ section.settings.red }}; --cream: {{ section.settings.cream }}; font-family: Karla, Arial, sans-serif; color: #1c2321; }
    .cp-{{ sid }} *, .cp-{{ sid }} *::before, .cp-{{ sid }} *::after { box-sizing: border-box; }
    .cp-{{ sid }} .cp__full { position: relative; width: 100vw; margin-left: calc(50% - 50vw); max-width: 100vw; overflow: hidden; }
    .cp-{{ sid }} .cp__in { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
    .cp-{{ sid }} .cp__eyebrow { display: flex; align-items: center; gap: 16px; font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 16px; letter-spacing: 6px; text-transform: uppercase; color: var(--red); margin-bottom: 14px; }
    .cp-{{ sid }} .cp__eyebrow::before { content: ""; width: 60px; height: 3px; background: var(--red); border-radius: 2px; }
    .cp-{{ sid }} .cp__h { display: block !important; visibility: visible !important; opacity: 1 !important; font-family: Oswald, Impact, 'Arial Narrow', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; line-height: 1.05; margin: 0 0 20px; font-size: 44px; color: var(--navy) !important; text-wrap: balance; }
    .cp-{{ sid }} .cp__hero { background: var(--navy) center / cover no-repeat; padding: 90px 0 120px; color: #fff; }
    .cp-{{ sid }} .cp__hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,26,51,.94) 0%, rgba(11,26,51,.8) 55%, rgba(11,26,51,.5) 100%); }
    .cp-{{ sid }} .cp__hero .cp__in { position: relative; }
    .cp-{{ sid }} .cp__hero .cp__h { color: #fff !important; font-size: 64px; margin-bottom: 14px; }
    .cp-{{ sid }} .cp__hero p { max-width: 640px; margin: 0; font-size: 22px; line-height: 1.55; color: #dbe1ee !important; font-family: Karla, Arial, sans-serif !important; }
    .cp-{{ sid }} .cp__cards { margin-top: -70px; position: relative; z-index: 2; }
    .cp-{{ sid }} .cp__cards .cp__in { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 22px; }
    .cp-{{ sid }} a.cp__card, .cp-{{ sid }} .cp__card { display: block; background: #fff; border: 1px solid #ece5d2; border-radius: 16px; padding: 30px 26px; box-shadow: 0 14px 36px rgba(11,26,51,.12); text-decoration: none !important; text-align: center; transition: transform .2s, box-shadow .2s; }
    .cp-{{ sid }} a.cp__card:hover { transform: translateY(-5px); box-shadow: 0 20px 44px rgba(11,26,51,.18); }
    .cp-{{ sid }} .cp__ic { display: inline-flex; width: 64px; height: 64px; border-radius: 50%; background: #fdecec; align-items: center; justify-content: center; margin-bottom: 14px; }
    .cp-{{ sid }} .cp__ic svg { width: 30px !important; height: 30px !important; fill: none !important; stroke: var(--red) !important; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .cp-{{ sid }} .cp__ic svg * { fill: none !important; stroke: var(--red) !important; }
    .cp-{{ sid }} .cp__ct { display: block; font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 16px; letter-spacing: 3px; text-transform: uppercase; color: #6b6b62 !important; margin-bottom: 8px; }
    .cp-{{ sid }} .cp__cv { display: block; font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 26px; line-height: 1.2; color: var(--navy) !important; overflow-wrap: anywhere; }
    .cp-{{ sid }} .cp__cv--sm { font-size: 22px; letter-spacing: 0; }
    .cp-{{ sid }} .cp__cards { overflow: visible; }
    .cp-{{ sid }} .cp__cs { display: block; margin-top: 8px; font-size: 16px; line-height: 1.5; color: #4a4a43 !important; }
    .cp-{{ sid }} .cp__main { padding: 80px 0 84px; }
    .cp-{{ sid }} .cp__main .cp__in { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 56px; align-items: start; }
    .cp-{{ sid }} .cp__form { background: #fff; border: 1px solid #ece5d2; border-radius: 18px; padding: 36px 34px; box-shadow: 0 14px 36px rgba(11,26,51,.1); }
    .cp-{{ sid }} .cp__form label { display: block; margin: 0 0 6px; font-family: Oswald, Impact, sans-serif; font-size: 15px; letter-spacing: 2px; text-transform: uppercase; color: var(--navy); }
    .cp-{{ sid }} .cp__form input[type=text], .cp-{{ sid }} .cp__form input[type=email], .cp-{{ sid }} .cp__form input[type=tel], .cp-{{ sid }} .cp__form textarea { display: block; width: 100%; height: auto; padding: 14px 16px; margin: 0 0 18px; font: 18px Karla, Arial, sans-serif; color: #1c2321; background: #fdfaf4; border: 2px solid #e4dcc7; border-radius: 8px; box-shadow: none; }
    .cp-{{ sid }} .cp__form textarea { min-height: 150px; resize: vertical; }
    .cp-{{ sid }} .cp__form input:focus, .cp-{{ sid }} .cp__form textarea:focus { outline: none; border-color: var(--navy); background: #fff; }
    .cp-{{ sid }} .cp__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .cp-{{ sid }} .cp__form button { display: block; width: 100%; padding: 20px; background: #e32d2d; color: #fff; border: 0; border-radius: 4px; font-family: Oswald, Impact, sans-serif; font-weight: 700; font-size: 22px; letter-spacing: 2.5px; text-transform: uppercase; cursor: pointer; box-shadow: 0 10px 26px rgba(227,45,45,.35); transition: background .18s, transform .18s; }
    .cp-{{ sid }} .cp__form button:hover { background: #c92222; transform: translateY(-2px); }
    .cp-{{ sid }} .cp__msg { padding: 14px 16px; margin-bottom: 20px; border-radius: 8px; font-size: 17px; font-weight: 700; }
    .cp-{{ sid }} .cp__msg--ok { background: #e6f4ea; color: #1e6b34; }
    .cp-{{ sid }} .cp__msg--err { background: #fdecec; color: #9b1a22; }
    .cp-{{ sid }} .cp__note { margin: 14px 0 0; font-size: 15px; color: #6b6b62 !important; text-align: center; }
    .cp-{{ sid }} .cp__list { list-style: none; margin: 0 0 24px; padding: 0; }
    .cp-{{ sid }} .cp__list li { position: relative; padding: 0 0 16px 40px; font-size: 19px; line-height: 1.55; color: #2b2b27; }
    .cp-{{ sid }} .cp__list li::before { content: "\2605"; position: absolute; left: 0; top: 1px; width: 26px; height: 26px; border-radius: 50%; background: var(--navy); color: #fff; font-size: 12px; display: flex; align-items: center; justify-content: center; }
    .cp-{{ sid }} .cp__list li.warn::before { content: "!"; background: var(--red); font-weight: 700; font-size: 15px; }
    .cp-{{ sid }} .cp__list strong { color: var(--navy); }
    .cp-{{ sid }} .cp__sign { margin: 8px 0 0; padding: 22px 24px; background: var(--cream); border-left: 5px solid var(--red); border-radius: 8px; font-size: 19px; line-height: 1.6; color: #2b2b27 !important; }
    .cp-{{ sid }} .cp__sign b { display: block; margin-top: 8px; font-family: Oswald, Impact, sans-serif; font-size: 22px; letter-spacing: 1px; text-transform: uppercase; color: var(--navy) !important; }
    .cp-{{ sid }} .cp__map { display: block; width: 100%; height: 380px; border: 0; }
    @media (max-width: 900px) {
      .cp-{{ sid }} .cp__hero { padding: 56px 0 100px; }
      .cp-{{ sid }} .cp__hero .cp__h { font-size: 40px; }
      .cp-{{ sid }} .cp__hero p { font-size: 18px; }
      .cp-{{ sid }} .cp__h { font-size: 34px; }
      .cp-{{ sid }} .cp__cards { margin-top: -56px; }
      .cp-{{ sid }} .cp__cards .cp__in { grid-template-columns: 1fr; gap: 16px; }
      .cp-{{ sid }} .cp__main { padding: 48px 0 56px; }
      .cp-{{ sid }} .cp__main .cp__in { grid-template-columns: 1fr; gap: 36px; }
      .cp-{{ sid }} .cp__form { padding: 26px 20px; }
      .cp-{{ sid }} .cp__row { grid-template-columns: 1fr; gap: 0; }
      .cp-{{ sid }} .cp__list li { font-size: 17px; }
      .cp-{{ sid }} .cp__map { height: 300px; }
    }
  </style>

  <section class="cp__full cp__hero" style="{% if section.settings.hero_asset != blank %}background-image:url('{{ section.settings.hero_asset | asset_url }}'){% endif %}">
    <div class="cp__in">
      <div class="cp__eyebrow" style="color:#ff8a8a">{{ section.settings.eyebrow | escape }}</div>
      <span class="cp__h" role="heading" aria-level="1">{{ section.settings.heading | escape }}</span>
      <p>{{ section.settings.intro | escape }}</p>
    </div>
  </section>

  <section class="cp__full cp__cards">
    <div class="cp__in">
      {%- assign email = section.settings.email -%}
      <a class="cp__card" href="mailto:{{ email }}">
        <span class="cp__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3z"/><path d="M3 7l9 7 9-7"/></svg></span>
        <span class="cp__ct">Email us</span>
        <span class="cp__cv cp__cv--sm">{{ email | escape }}</span>
        <span class="cp__cs">Email is the fastest way to reach us.</span>
      </a>
      <a class="cp__card" href="tel:{{ section.settings.phone | remove: '-' | remove: ' ' }}">
        <span class="cp__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/></svg></span>
        <span class="cp__ct">Call us</span>
        <span class="cp__cv">{{ section.settings.phone | escape }}</span>
        <span class="cp__cs">{{ section.settings.phone_note | escape }}</span>
      </a>
      <a class="cp__card" href="https://www.google.com/maps/search/?api=1&query={{ section.settings.address | url_encode }}" target="_blank" rel="noopener">
        <span class="cp__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
        <span class="cp__ct">Visit the farm</span>
        <span class="cp__cv">{{ section.settings.address | escape }}</span>
        <span class="cp__cs">By appointment only.</span>
      </a>
    </div>
  </section>

  <section class="cp__full cp__main">
    <div class="cp__in">
      <div class="cp__form">
        <span class="cp__h" role="heading" aria-level="2" style="font-size:34px">{{ section.settings.form_title | escape }}</span>
        {%- form 'contact', id: 'cp-form' -%}
          {%- if form.posted_successfully? -%}<div class="cp__msg cp__msg--ok" role="alert">Thanks! Your message was sent. We'll get back to you soon.</div>{%- endif -%}
          {%- if form.errors -%}<div class="cp__msg cp__msg--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="cp__row">
            <div><label for="cp-name">Name</label><input id="cp-name" type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required></div>
            <div><label for="cp-email">Email</label><input id="cp-email" type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required></div>
          </div>
          <label for="cp-phone">Phone (optional)</label>
          <input id="cp-phone" type="tel" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
          <label for="cp-body">How can we help?</label>
          <textarea id="cp-body" name="contact[body]" required>{{ form.body }}</textarea>
          <button type="submit">Send Message</button>
          <p class="cp__note">{{ section.settings.form_note | escape }}</p>
        {%- endform -%}
      </div>

      <div>
        <div class="cp__eyebrow">{{ section.settings.info_eyebrow | escape }}</div>
        <span class="cp__h" role="heading" aria-level="2">{{ section.settings.info_title | escape }}</span>
        <ul class="cp__list">
          {%- for i in (1..6) -%}
            {%- assign k = 'point_' | append: i -%}
            {%- if section.settings[k] != blank -%}<li{% if section.settings[k] contains '!' and i > 3 %} class="warn"{% endif %}>{{ section.settings[k] }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
        <p class="cp__sign">{{ section.settings.signoff | escape }}<b>{{ section.settings.signer | escape }}</b></p>
      </div>
    </div>
  </section>

  <section class="cp__full">
    <iframe class="cp__map" title="Freedom Farms location" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q={{ section.settings.address | append: ', ' | append: section.settings.address_city | url_encode }}&output=embed"></iframe>
  </section>
</div>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "header", "content": "Top" },
    { "type": "text", "id": "hero_asset", "label": "Hero photo from theme files (optional)", "default": "farm-hero.png" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "We'd love to hear from you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Questions about your order? Email is fastest, or give us a call. We look forward to meeting you at the farm as our guests!" },
    { "type": "header", "content": "Contact details" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@wearefreedomfarms.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "607-444-1396" },
    { "type": "text", "id": "phone_note", "label": "Phone note", "default": "Questions about your order? Call us." },
    { "type": "text", "id": "address", "label": "Street address", "default": "237 Ott Rd" },
    { "type": "text", "id": "address_city", "label": "City, state, zip", "default": "Greene, NY 13778" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_title", "label": "Form title", "default": "Send Us A Message" },
    { "type": "text", "id": "form_note", "label": "Small line under the button", "default": "Due to our order volume, if you have not received your order in 14 days, please reach out." },
    { "type": "header", "content": "Visiting and orders" },
    { "type": "text", "id": "info_eyebrow", "label": "Small heading", "default": "Before you visit" },
    { "type": "text", "id": "info_title", "label": "Title", "default": "Visiting The Farm" },
    { "type": "textarea", "id": "point_1", "label": "Point 1", "default": "We do not have a store on the farm (yet). All visits must be scheduled." },
    { "type": "textarea", "id": "point_2", "label": "Point 2", "default": "If you order in advance, we can have your order ready for pickup when you arrive." },
    { "type": "textarea", "id": "point_3", "label": "Point 3", "default": "Looking for a quarter, half or whole cow, or a special order? Email us and we'll set it up." },
    { "type": "textarea", "id": "point_4", "label": "Point 4", "default": "Pick-ups will be on Tuesdays and Wednesdays at our store at 43 Genesee St., Greene NY 13778 by appointment only." },
    { "type": "textarea", "id": "point_5", "label": "Point 5 (red)", "default": "Please do not show up to the farm without an appointment!" },
    { "type": "textarea", "id": "point_6", "label": "Point 6 (red)", "default": "We do not do tours or pickups on Sundays. Farm tours begin again in June!" },
    { "type": "textarea", "id": "signoff", "label": "Sign-off", "default": "Stay Free. Let's Make Meat Great Again. 🇺🇸" },
    { "type": "text", "id": "signer", "label": "Signed", "default": "The Cavalea Family" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "navy", "label": "Navy", "default": "#0b1a33" },
    { "type": "color", "id": "red", "label": "Red", "default": "#c8232c" },
    { "type": "color", "id": "cream", "label": "Background", "default": "#fdf5ea" }
  ],
  "presets": [{ "name": "Contact page" }]
}
{% endschema %}
