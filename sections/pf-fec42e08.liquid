assign product = defaultProduct %}</div><div data-pf-type="Custom.HTML" class="sc-kJpDiM pf-246_"><script>
let userPaused = new WeakSet();
let userMuted = new WeakSet();

document.querySelectorAll('.pf-media-wrapper video').forEach(video => {

  video.setAttribute('playsinline', '');
  video.muted = true; // autoplay ke liye start muted

  video.play().catch(()=>{});

  // Track pause
  video.addEventListener('pause', () => {
    if (video.closest('.pf-slide-main-media.is-current')) {
      userPaused.add(video);
    }
  });

  video.addEventListener('play', () => {
    userPaused.delete(video);
  });

  // Track mute/unmute via controls
  video.addEventListener('volumechange', () => {
    if (video.muted) {
      userMuted.add(video);
    } else {
      userMuted.delete(video);
    }
  });

});

setInterval(() => {
  document.querySelectorAll('.pf-media-wrapper video').forEach(video => {

    let isActive = video.closest('.pf-slide-main-media.is-current');

    if (isActive) {

      // ▶️ Play if needed
      if (!userPaused.has(video) && video.paused) {
        video.play().catch(()=>{});
      }

      // 🔊 Unmute only if user ne mute nahi kiya
      if (!userMuted.has(video)) {
        video.muted = false;
      }

    } else {
      // ⛔ Background videos
      video.pause();
      video.muted = true;
      userPaused.delete(video);
    }

  });
}, 800); // thoda fast response
</script></div></div></section><section data-section-id="pf-cad3" data-category="FAQs" data-name="Lovey" data-pf-type="FlexSection" class="sc-bvFjeY dfQJTW pf-247_ pf-color-scheme-1"><div class="sc-emDrzp DukVE pf-flex-section"><h3 data-pf-type="Heading2" class="sc-ckSceh cxDqq pf-248_ pf-heading-1-h3">Frequently Asked Questions</h3><p class="sc-chKnEw cKwowb pf-250_ pf-text-1" data-pf-type="Paragraph3">Have a Question? We’ve Got the Answer!</p><div class="sc-hYQmIO hyXtdh pf-252_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-hJZIGr iDoMvj pf-253_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-jlsrac RkmTy pf-254_ pf-anchor pf-header-item-wrapper" data-header-id="f47d6bcd-cb30-457a-bbbe-f84d313df6bd" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Where does your meat come from?</span></div></summary><div class="sc-iWBMXF pf-256_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-gdWTkz lkydnr pf-257_"><p class="sc-chKnEw cKwowb pf-258_ pf-text-1" data-pf-type="Paragraph3">All of our beef, pork, and chicken are raised right here in the USA. We partner with trusted American farms that share our commitment to quality, animal welfare, and clean food.</p></div></div></div></details><details class="sc-hJZIGr iDoMvj pf-260_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-jlsrac RkmTy pf-261_ pf-anchor pf-header-item-wrapper" data-header-id="0847c3ef-86ba-4c72-bf85-85d8af41d3fe" data-active="false