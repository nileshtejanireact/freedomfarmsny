      "settings": {
        "row_stretch": "default",
        "code": "<section class=\"faq-page\">\n\n  <div class=\"faq-hero\">\n    <h1 style=\"    font-family: Impact, sans-serif;\">Frequently Asked Questions</h1>\n    <p>Everything you need to know about ordering premium beef and pork from Freedom Farms.</p>\n<h4><strong>We ship our meats NATIONWIDE.</strong></h4>\n\n    <div class=\"quick-facts\">\n      <div class=\"fact\">\n        <span>🚚</span>\n        <strong>Nationwide Shipping</strong>\n      </div>\n      <div class=\"fact\">\n        <span>✅</span>\n        <strong>USDA Processed</strong>\n      </div>\n      <div class=\"fact\">\n        <span>📦</span>\n        <strong>Delivered right to\nyour door</strong>\n      </div>\n      <!--div class=\"fact\">\n        <span>⏱️</span>\n        <strong>30–60 Day Turnaround</strong>\n      </div-->\n    </div>\n  </div>\n\n  <!-- ORDERING -->\n  <div class=\"faq-category\">\n    <h2 style=\"    font-family: Impact, sans-serif;\">Ordering Meat Shares</h2>\n\n    <details>\n      <summary>What is a meat share?</summary>\n      <p>\n        A meat share allows you to reserve a portion of a cow or pig before\n        processing. Choose from quarter, half, or whole shares.\n      </p>\n    </details>\n\n    <details>\n      <summary>Why buy a meat share instead of individual cuts?</summary>\n      <p>\n        Better value per pound, premium farm-raised meat, and a fully stocked freezer.\n      </p>\n    </details>\n\n    <details>\n      <summary>Is a whole animal too much meat?</summary>\n      <p>\n        Many customers split larger shares with family or friends.\n      </p>\n    </details>\n  </div>\n\n  <!-- FREEZER SPACE -->\n  <div class=\"faq-category\">\n    <h2 style=\"    font-family: Impact, sans-serif;\">Freezer Space &amp; Yield</h2>\n\n    <details>\n      <summary>How much freezer space do I need?</summary>\n\n      <div class=\"table-wrapper\">\n        <table>\n          <thead>\n            <tr>\n              <th>Share Size</th>\n              <th>Recommended Freezer</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td>Quarter Cow</td>\n              <td>5.0 cu ft</td>\n            </tr>\n            <tr>\n              <td>Half Cow</td>\n              <td>7.0 cu ft</td>\n            </tr>\n            <tr>\n              <td>Whole Cow</td>\n              <td>14.8 cu ft</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </details>\n\n    <details>\n      <summary>How much meat will I receive?</summary>\n      <p>\n        Take-home meat is typically about 60% of hanging weight after aging and processing.\n      </p>\n    </details>\n\n    <details>\n      <summary>What is hanging weight?</summary>\n      <p>\n        Hanging weight is the weight after the hide, head, organs, and lower legs\n        have been removed but before processing into retail cuts.\n      </p>\n    </details>\n  </div>\n\n  <!-- FARMING -->\n  <div class=\"faq-category\">\n    <h2 style=\"    font-family: Impact, sans-serif;\">Farming Practices</h2>\n\n    <details>\n      <summary>Are your meats USDA processed?</summary>\n      <p>Yes. All meat is processed in a USDA-inspected facility.</p>\n    </details>\n\n    <details>\n      <summary>Do you use antibiotics?</summary>\n      <p>\n        Animals are treated when medically necessary and all USDA withdrawal\n        requirements are followed.\n      </p>\n    </details>\n\n    <details>\n      <summary>Do you raise all your own animals?</summary>\n      <p>\n        We raise animals on our farm and work with trusted partner farms that\n        meet our standards.\n      </p>\n    </details>\n    <details>\n      <summary>What are the cows fed?</summary>\n      <p>Our cows are fed primarily a grass-fed and forage based diet. To get through the winters and energy demands of our region- as well as increase intramuscular fat and marbling- we do finish our beef on silage and grain.</p>\n    </details>\n\n\n  </div>\n\n  <!-- SHIPPING -->\n  <div class=\"faq-category\">\n    <h2 style=\"    font-family: Impact, sans-serif;\">Shipping &amp; Delivery</h2>\n\n    <details>\n      <summary>Do you ship nationwide?</summary>\n      <p>Yes, we ship throughout the United States.</p>\n    </details>\n\n    <details>\n      <summary>How long does delivery take?</summary>\n      <p>\n        Meat shares typically arrive within 30–60 days. Smaller box orders\n        generally arrive within 2 weeks.\n      </p>\n    </details>\n\n    <details>\n      <summary>Can I pick up my order?</summary>\n      <p>\n        Yes. Farm pickup is available by appointment.\n      </p>\n    </details>\n  </div>\n\n  <!-- CTA -->\n  <div class=\"faq-contact\">\n    <h2 style=\"font-family: Impact, sans-serif;\">Still Have Questions?</h2>\n    <p>\n      We'd love to help. Reach out and we'll get back to you as soon as possible.\n    </p>\n\n    <a href=\"/pages/contact-us\" class=\"faq-btn\">\n      Contact Us\n    </a>\n  </div>\n\n</section>\n<style>\n.main-header {\n    margin-bottom: 0;\n}\n.faq-page {\n  max-width: 1000px;\n  margin: 0 auto;\n  padding: 80px 20px;\n  font-family: inherit;\n}\n\n.faq-hero {\n  text-align: center;\n  margin-bottom: 60px;\n}\n\n.faq-hero h1 {\n  font-size: 48px;\n  font-weight: 800;\n  margin-bottom: 15px;\n  color: #1f2937;\n}\n\n.faq-hero p {\n  font-size: 18px;\n  color: #6b7280;\n  max-width: 700px;\n  margin: auto;\n}\n\n.quick-facts {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 16px;\n  margin-top: 40px;\n}\n\n.fact {\n  background: #fff;\n  border: 1px solid #e5e7eb;\n  padding: 20px;\n  border-radius: 14px;\n  text-align: center;\n}\n\n.fact span {\n  display: block;\n  font-size: 28px;\n  margin-bottom: 10px;\n}\n\n.faq-category {\n  margin-bottom: 50px;\n}\n\n.faq-category h2 {\n  font-size: 32px;\n  margin-bottom: 20px;\n  color: #111827;\n}\n\ndetails {\n  border: 1px solid #e5e7eb;\n  border-radius: 12px;\n  margin-bottom: 12px;\n  overflow: hidden;\n  background: white;\n}\n\nsummary {\n  list-style: none;\n  cursor: pointer;\n  padding: 22px;\n  font-size: 18px;\n  font-weight: 600;\n  position: relative;\n}\n\nsummary::-webkit-details-marker {\n  display: none;\n}\n\nsummary::after {\n  content: \"+\";\n  position: absolute;\n  right: 22px;\n  top: 50%;\n  transform: translateY(-50%);\n  font-size: 24px;\n  color: #666;\n}\n\ndetails[open] summary::after {\n  content: \"−\";\n}\n\ndetails p,\ndetails .table-wrapper {\n  padding: 0 22px 22px;\n  color: #555;\n  line-height: 1.7;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n}\n\ntable th,\ntable td {\n  padding: 14px;\n  border-bottom: 1px solid #e5e7eb;\n  text-align: left;\n}\n\ntable th {\n  background: #f9fafb;\n}\n\n.faq-contact {\n  margin-top: 70px;\n  text-align: center;\n  background: #f8f5ef;\n  padding: 50px 30px;\n  border-radius: 20px;\n}\n\n.faq-contact h2 {\n  font-size: 36px;\n  margin-bottom: 12px;\n}\n\n.faq-contact p {\n  color: #666;\n  margin-bottom: 24px;\n}\n\n.faq-btn {\n  display: inline-block;\n  background: #b38728;\n  color: white;\n  padding: 14px 32px;\n  border-radius: 999px;\n  text-decoration: none;\n  font-weight: 700;\n  transition: 0.3s;\n}\n\n.faq-btn:hover {\n  background: #8f6919;\n}\n\n@media (max-width: 768px) {\n  .faq-hero h1 {\n    font-size: 36px;\n  }\n\n  .quick-facts {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .faq-category h2 {\n    font-size: 26px;\n  }\n\n  summary {\n    font-size: 16px;\n  }\n}\n\n@media (max-width: 480px) {\n  .quick-facts {\n    grid-template-columns: 1fr;\n  }\n}\n</style>",
