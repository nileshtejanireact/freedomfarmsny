        "row_stretch": "default",
        "code": "<section class=\"our-journey\">\n    <div class=\"container\">\n\n        <div class=\"journey-content\">\n\n            <!-- Left Content -->\n            <div class=\"journey-text\">\n\n                <h2>OUR JOURNEY</h2>\n\n                <div class=\"heading-divider\">\n                    <span></span>\n                    <svg width=\"22\" height=\"22\" viewbox=\"0 0 24 24\">\n                        <path fill=\"#0B2A5B\" d=\"M12 3L14 8H19L15 11L17 16L12 13L7 16L9 11L5 8H10L12 3Z\"></path>\n                    </svg>\n                    <span></span>\n                </div>\n\n                <p>\n                    Freedom Farms was started by Dana &amp; Lauren Cavalea.\n                    The two met in high school and eventually went their\n                    separate ways for college and the years that followed.\n                </p>\n\n                <p>\n                    About a decade later the two reunited and have been on\n                    a journey ever since. Lauren spent her career working\n                    in news for ABC News, while Coach Dana Cavalea became a\n                    World Champion Coach for the New York Yankees.\n                </p>\n\n                <div class=\"highlight-title\">\n                    <div class=\"icon\">\n                        ★\n                    </div>\n\n                    <div class=\"title-text\">\n                        WHAT DO YOU GET WHEN A PROFESSIONAL\n                        SPORTS COACH AND A NEWS AFICIONADO GET TOGETHER?\n                    </div>\n                </div>\n\n                <p>\n                    You get <strong>Freedom Farms.</strong>\n                    A 270 acre farm in Upstate NY shipping meats nationwide.\n                    We are a PRO-AMERICA, PRO-FREEDOM Farm that loves America\n                    and we are 100% committed to keeping American Farms Being\n                    Farmed by Americans!\n                </p>\n\n                <p>\n                    Together, along with the farm's mascots, Rocco &amp; Lucci, and Santino (our English Bulldogs), Gunner and Bullet, the farm is worked daily and filled with energy— producing the best and healthiest <a href=\"https://wearefreedomfarms.com/collections/beef\"><strong>local grass fed beef</strong></a> in New York.\n                </p>\n<a href=\"https://wearefreedomfarms.com/collections/beef\">\n\n            </a>\n</div>\n<a href=\"https://wearefreedomfarms.com/collections/beef\">\n\n            <!-- Right Image -->\n            <div class=\"journey-image\">\n                <img src=\"https://cdn.shopify.com/s/files/1/0529/2376/0823/files/515503716_795711799468947_5880284339870322737_n_da4006b9-ac42-43e7-a2e2-6a52c5dfd8f2.jpg?v=1781243357\" alt=\"Freedom Farms\">\n            </div>\n\n        </a>\n</div>\n<a href=\"https://wearefreedomfarms.com/collections/beef\">\n\n    </a>\n</div>\n<a href=\"https://wearefreedomfarms.com/collections/beef\">\n</a></section><a href=\"https://wearefreedomfarms.com/collections/beef\">\n<style>\n.main-header {\n    margin-bottom: 0;\n}\n.our-journey {\n    background: #f5f1ea;\n    padding: 90px 0;\n}\n\n.container {\n    width: 90%;\n    max-width: 1400px;\n    margin: auto;\n}\n\n.journey-content {\n    display: flex;\n    gap: 70px;\n    align-items: flex-start;\n}\n\n.journey-text {\n    flex: 1;\n    max-width: 600px;\n}\n\n.journey-text h2 {\n    font-size: 36px;\n    line-height: 1;\n    color: #0b2a5b;\n    font-weight: 900;\n    margin-bottom: 25px;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    font-family: Impact, sans-serif;\n}\n\n.heading-divider {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    margin-bottom: 40px;\n}\n\n.heading-divider span {\n    width: 140px;\n    height: 3px;\n    background: #d83b3b;\n}\n\n.journey-text p {\n    font-size: 22px;\n    line-height: 1.8;\n    color: #222;\n    margin-bottom: 32px;\n}\n\n.highlight-title {\n    displ