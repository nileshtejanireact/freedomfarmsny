          "302240d8-df60-43fc-97d3-927474372927-1684998125098fe780-1": {
            "type": "information",
            "settings": {
              "banner_width": "4",
              "image": "shopify://shop_images/ChatGPT_Image_Jul_19_2025_10_13_55_AM.png",
              "svg_link": "",
              "banner_content": "<h4>Chicken</h4><p> At Freedom Farms, everything we offer is guided by the same standards we live by on our farm. Our chicken is thoughtfully sourced, carefully handled, and selected with quality in mind—so you get dependable cuts that cook well and deliver great flavor every time. </p>",
              "banner_btn_title": "SHOP CHICKEN",
              "banner_link": "shopify://collections/100-pasture-raised-chicken",
              "button_style": "static",
              "button_design": "style_2",
              "banner_alignment": "center",
              "banner_vertical_alignment": "top",
