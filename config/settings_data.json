      "custom_content_XTMnYP": {
        "type": "custom-content",
        "disabled": true,
        "settings": {
          "row_stretch": "default",
          "code": "<h2 style=\"color:#000000;font-size:48px; text-align: center;\">Buy Half a Cow Grass Fed</h2>\n<div style=\"  \">\n<p style=\"font-size:22px;\"><strong>Experience Premium Farm Products with 100% Pasture-Raised Meats and Eggs</strong></p> \n\n<p style=\"font-size:22px; color:#000000B3; text-align: justify;\">Welcome to Freedom Farms, where sustainability meets excellence (<b><a href=\"https://wearefreedomfarms.com/products/half-cow-box\" style=\"color:#2B00ff;\">Half a Cow</a></b>, <b><a href=\"https://wearefreedomfarms.com/collections/beef\" style=\"color:#2B00ff;\">Grass Fed Beef</a></b>, <b><a href=\"https://wearefreedomfarms.com/collections/pork\" style=\"color:#2B00ff;\">Local Pork Meat</a></b>, <b><a href=\"https://wearefreedomfarms.com/products/pork-belly\" style=\"color:#2B00ff;\">Pork Bellies</a></b>, <b><a href=\"https://wearefreedomfarms.com/products/whole-cow\" style=\"color:#2B00ff;\">Whole Cow Meat</a></b>). Our Local Meat Farms is committed to providing you with the best<b><a href=\"https://wearefreedomfarms.com/collections/100-pasture-raised-chicken\" style=\"color:#2B00ff;\"> pasture-raised meats</a></b> and eggs so that every item you get is created with care, respect for nature, and an eye on animal welfare. We value openness. Hence, we inform you precisely where your food originates from and how it is grown.</p>\n\n<p style=\"font-size:22px; color:#000000B3; text-align: justify;\">From our tender pork bellies to our pasture-grown hens, every one of our animals is ethically produced free from hormones and antibiotics. Choosing us helps you support a movement toward better, more compassionate agricultural methods, not just feeding your family. Every Farm Fresh Meat you provide is guaranteed by our approach to be tasty, healthy, and consistent with your beliefs.</p>\n\n<p style=\"font-size:22px; color:#000000B3; text-align: justify;\">We have you covered whether your goals are to get the freshest eggs available or fill your freezer with premium meats. Join the expanding family community that depends on Freedom Farms for their farm-to-table requirements and see the impact real pasture-raised goods can bring to your meals. Discover our choices right now and start your family's and the earth's towards a better, more sustainable future.\n</p>\n</div>",
          "section_bg_color": "",
          "section_border_color": "",
          "section_border_style": "solid",
          "section_border": "",
          "section_margin_top": "",
          "section_margin_bottom": "",
          "section_padding_top": "",
          "section_padding_right": "",
          "section_padding_bottom": "",
          "section_padding_left": "",
          "hidden_section": false
        }
      },
