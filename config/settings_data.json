            "type": "information",
            "settings": {
              "banner_width": "4",
              "image": "shopify://shop_images/ChatGPT_Image_Jul_19_2025_10_08_54_AM.png",
              "svg_link": "",
              "banner_content": "<h4>Beef</h4><p> At Freedom Farms, our roots are in the day-to-day work of the farm, and that mindset carries into everything we offer. Our beef is carefully sourced with a focus on quality, consistency, and how it shows up on your plate. Every cut is selected to deliver great flavor and a dependable eating experience you can count on. </p>",
              "banner_btn_title": "SHOP BEEF",
              "banner_link": "shopify://collections/beef",
              "button_style": "static",
              "button_design": "style_2",
              "banner_alignment": "center",
              "banner_vertical_alignment": "top",
              "box_style": "base",
              "banner_color": "dark",
              "block_border_color": "",
              "block_border_style": "solid",
              "block_border": "",
              "block_margin_top": "",
              "block_margin_bottom": "",
